  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "archive": "pnpm build && bash scripts/archive.sh",
    "package": "bash scripts/archive.sh",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{js,mjs,ts,vue}\" \"preflight/**/*.{js,mjs,ts,vue}\" \"shortcuts/**/*.{js,mjs,ts,vue}\" \"scripts/**/*.{js,mjs,ts,vue}\" \"*.{js,mjs,ts}\"",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern \"src/**/*.{js,mjs,ts,vue}\" \"preflight/**/*.{js,mjs,ts,vue}\" \"shortcuts/**/*.{js,mjs,ts,vue}\" \"scripts/**/*.{js,mjs,ts,vue}\" \"*.{js,mjs,ts}\"",
    "release:patch": "changelogen --release --patch",
    "release:minor": "changelogen --release --minor",
    "release:major": "changelogen --release --major",
    "oco": "opencommit",
    "lloco": "OCO_AI_PROVIDER='ollama' opencommit"
  },
  "dependencies": {
    "@iconify-json/fa6-solid": "^1.2.4",
