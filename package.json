  "changelog": {
    "types": {
      "feat": {
        "title": "🚀 新機能",
        "semver": "minor"
      },
      "fix": {
        "title": "🐛 バグ修正",
        "semver": "patch"
      },
      "perf": {
        "title": "⚡ パフォーマンスの向上",
        "semver": "patch"
      },
      "refactor": {
        "title": "♻️ リファクタリング",
        "semver": "patch"
      },
      "docs": {
        "title": "📖 ドキュメント"
      },
      "style": {
        "title": "🎨 コードスタイル"
      },
      "test": {
        "title": "✅ テストの追加・修正"
      },
      "ci": {
        "title": "🤖 CI関連"
      },
      "build": {
        "title": "📦 ビルド",
        "semver": "patch"
      },
      "chore": {
        "title": "🧹 ビルドプロセスまたは補助ツールの変更"
      },
      "config": {
        "title": "🔧 設定ファイル"
      },
      "package": {
        "title": "📦 パッケージ"
      }
    },
    "templates": {
      "commitMessage": "chore(release): 🏹v{{newVersion}}",
      "tagMessage": "v{{newVersion}}",
      "tagBody": "v{{newVersion}}"
    }
  }
}
